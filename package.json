{
  "name": "quickprompt",
  "productName": "QuickPrompt",
  "description": "A simple prompt manager - create, tag, and copy prompts instantly",
  "private": true,
  "version": "2.6.0",
  "author": {
    "name": "Muhammad Bilal Hassan",
    "email": "bilals2008@users.noreply.github.com"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && electron-builder",
    "dist:win": "vite build && electron-builder --win nsis",
    "dist:mac": "vite build && electron-builder --mac",
    "dist:mac:arm": "vite build && electron-builder --mac --arm64",
    "dist:all": "vite build && electron-builder --win nsis --mac",
    "dist:linux": "vite build && electron-builder --linux",
    "release:win": "vite build && electron-builder --win nsis --publish always",
    "release:mac": "vite build && electron-builder --mac --publish always",
    "release:linux": "vite build && electron-builder --linux --publish always",
    "release:all": "vite build && electron-builder --win nsis --mac --linux --publish always",
    "release:draft": "vite build && electron-builder --win nsis --mac --linux --publish always",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "electron-updater": "^6.8.9",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tabler/icons-react": "^3.49.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "electron": "^44.7.0",
    "electron-builder": "^26.17.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.3.4",
    "vite-plugin-electron": "^1.1.2",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vitest": "^5.0.3"
  },
  "main": "dist-electron/main.js",
  "build": {
    "appId": "com.quickprompt.app",
    "productName": "QuickPrompt",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "dist-electron/main.js"
    },
    "mac": {
      "icon": "build/icon.png",
      "artifactName": "QuickPrompt-${version}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "artifactName": "QuickPrompt-Setup-${version}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "artifactName": "QuickPrompt-${version}.${ext}",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "differentialPackage": true
    },
    "publish": {
      "provider": "github",
      "owner": "bilals2008",
      "repo": "QuickPrompt"
    }
  }
}
