{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuickPrompt",
  "version": "3.0.0",
  "identifier": "com.quickprompt.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "QuickPrompt",
        "width": 500,
        "height": 700,
        "minWidth": 360,
        "minHeight": 400,
        "maxWidth": 500,
        "maximizable": false,
        "decorations": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "dmg", "appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg2MTY2OUQ5ODY4OEU2QzgKUldUSTVvaUcyV2tXaHF0VkpJbHE4Y1kwZEFoWmhuOVNyZll2aXhOVmk1ZlRleFVxYzE4QTVPMXcK",
      "endpoints": [
        "https://github.com/bilals2008/QuickPrompt/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
