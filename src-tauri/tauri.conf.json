{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuickPrompt",
  "version": "2.6.0",
  "identifier": "com.quickprompt.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "QuickPrompt",
        "width": 500,
        "height": 700,
        "minWidth": 360,
        "minHeight": 400,
        "maxWidth": 500,
        "maximizable": false,
        "decorations": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
